{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go: Launch current package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}"
        },
        {
            "name": "Go: Run API (local Postgres)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/api/main.go",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                // Override o host do Postgres para depuração local (fora do Docker)
                "PG_DSN": "postgres://postgres:postgres@localhost:5432/oficina?sslmode=disable",
                "PORT": "8080"
            }
        },
        {
            "name": "Go: Debug tests (current package)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.testing",
            "env": {
                // Ajuste se seu Postgres de testes está fora do Docker
                // "PG_DSN": "postgres://postgres:postgres@localhost:5432/oficina_test?sslmode=disable"
            }
        }
    ]
}
